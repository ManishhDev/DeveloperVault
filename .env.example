# Postgres from `docker compose up -d` (or `npm run db:local` if you don't have Docker)
DATABASE_URL="postgresql://devvault:devvault@localhost:5432/devvault?schema=public"
# Optional: tests use a separate schema of the same database by default
# TEST_DATABASE_URL="postgresql://devvault:devvault@localhost:5432/devvault?schema=test"
PORT=4000
# Comma-separated origins allowed to call the API (only needed when client and API are on different domains)
CLIENT_ORIGIN="http://localhost:5173"
